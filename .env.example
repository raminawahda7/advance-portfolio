# ---- Local dev (SQLite) ----
# Prisma datasource url. For SQLite keep the file:./ prefix.
DATABASE_URL="file:./dev.db"

# ---- Production (Postgres / Supabase) ----
# To swap: in prisma/schema.prisma change datasource provider from "sqlite" to "postgresql",
# then set DATABASE_URL to your Postgres/Supabase connection string, e.g.:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"
# For Supabase, use the pooled connection string (port 6543) + add DIRECT_URL for migrations.

# Admin panel password (protects /admin). Change this to a strong secret.
ADMIN_PASSWORD="change-me-to-a-strong-password"
